{
  "name": "task-management-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Functions v4 Task Management API with Azure Cosmos DB",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "clean": "rimraf dist",
    "start": "npm run build && func start",
    "start:storage": "azurite --silent --location .azurite --debug .azurite/debug.log",
    "start:web": "vite --config web/vite.config.ts",
    "start:watch": "tsc --watch",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@azure/cosmos": "^4.2.0",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.5.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4",
    "vite": "^7.3.6"
  }
}
